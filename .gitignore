# Track documentation/configuration within otherwise local calibration directories.
!**/calibration/
**/calibration/*
!**/calibration/README.md
!**/calibration/*.yaml
!**/calibration/*.yml

# 仅跟踪 RTMPose 覆盖度报告和生成脚本，保留其他本地数据资产的忽略规则。
!tensorrt-rtmpose-hand/calibration/coverage.json
!tensorrt-rtmpose-hand/calibration/provenance/
tensorrt-rtmpose-hand/calibration/provenance/*
!tensorrt-rtmpose-hand/calibration/provenance/generate_coverage.py

# RTMPose 参考契约与精简核验结果；图片和逐样本输出留在本地。
!tensorrt-rtmpose-hand/configs/rtmpose_hand_reference.json
!tensorrt-rtmpose-hand/configs/rtmpose_hand_reference.verification.json
tensorrt-rtmpose-hand/validation/reference-freeze/

# RTMPose FP32 实测输出本地保存，冻结配置及报告摘要纳入版本控制。
tensorrt-rtmpose-hand/validation/trt-fp32/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_trt_fp32.json
!tensorrt-rtmpose-hand/benchmarks/fp32-baseline.json

# RTMPose FP16 配置与精简报告；原始输出留在本地。
tensorrt-rtmpose-hand/validation/trt-fp16/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_trt_fp16.json
!tensorrt-rtmpose-hand/benchmarks/fp16-baseline.json
!tensorrt-rtmpose-hand/configs/rtmpose_hand_builder.json
tensorrt-rtmpose-hand/validation/trt-fp16-cpp-2g/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_trt_fp16_cpp_2g.json
!tensorrt-rtmpose-hand/benchmarks/fp16-cpp-2g.json
tensorrt-rtmpose-hand/validation/simcc-margin/
!tensorrt-rtmpose-hand/benchmarks/simcc-margin.json

# 同公共 builder、2 GiB 的性能对照；保留配置和摘要，原始采样本地保存。
tensorrt-rtmpose-hand/validation/cpp-2g-performance/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_builder_fp32_2g.json
!tensorrt-rtmpose-hand/benchmarks/cpp-2g-performance.json

# RTMPose INT8准备记录；cache及原始检查产物本地保存。
tensorrt-rtmpose-hand/validation/int8-preparation/
tensorrt-rtmpose-hand/calibration/rtmpose_hand_int8.cache*
!tensorrt-rtmpose-hand/configs/rtmpose_hand_builder_int8.json
!tensorrt-rtmpose-hand/benchmarks/int8-preparation.json

# INT8首轮实验：原始输出留本地，配置与摘要纳入版本控制。
tensorrt-rtmpose-hand/validation/trt-int8/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_trt_int8.json
!tensorrt-rtmpose-hand/benchmarks/int8-baseline.json
# INT8 启用 FP16 fallback 的独立校准产物。
tensorrt-rtmpose-hand/calibration/rtmpose_hand_int8_fp16.cache*
# Calibration 范围图和 FP16 fallback 构建日志本地保存。
tensorrt-rtmpose-hand/validation/calibration-ranges-*/
tensorrt-rtmpose-hand/validation/trt-int8-fp16/
!tensorrt-rtmpose-hand/configs/rtmpose_hand_trt_int8_fp16.json
!tensorrt-rtmpose-hand/benchmarks/int8-fp16-fallback.json
# FP16 激活诊断的派生模型、engine 和中间输出留在本机。
tensorrt-rtmpose-hand/validation/fp16-activations*/
!tensorrt-rtmpose-hand/benchmarks/fp16-activations.json
# 关键点人工对照图、原图裁剪及本地HTML报告。
tensorrt-rtmpose-hand/validation/fp16-visual-review*/
tensorrt-rtmpose-hand/validation/fp16-keypoint-review*/
tensorrt-rtmpose-hand/validation/precision-keypoint-review*/
